# Backend environment (used by `npm start`, `npm run init-db`, and other root scripts).
# Copy to server/.env and fill in real values. Never commit server/.env.

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=generate-a-long-random-string
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000

# Supabase Postgres (Dashboard → Project Settings → Database → URI)
# Use the Transaction pooler URI (port 6543) for hosted/serverless; direct URI (port 5432) is fine locally.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase API + Storage (server only — never put these in VITE_* / frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret
SUPABASE_STORAGE_BUCKET=uploaded-pdfs

# Protects POST /api/internal/cleanup-pdfs (and the Edge Function if you set the same secret there)
CRON_SECRET=generate-a-long-random-string

# Optional: seed admin accounts when running `npm run init-db`
ADMIN_EMAIL=
ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: one-time copy from legacy MySQL (`npm run migrate-mysql`)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=campusprint

# Cashfree Payments (server only)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_DEFAULT_PHONE=9999999999
