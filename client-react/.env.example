# Optional Vite variable. Safe to expose in the browser.
#
# Leave empty (recommended) when:
# - `npm run dev:client` uses the Vite `/api` proxy to http://localhost:3000
# - production serves the built SPA from the Express server (same origin)
#
# Set this only if the React app is hosted on a different origin than the API.
VITE_API_URL=
